POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tkai_marketplace
POSTGRES_USER=tkai
# Supply through Windows Credential Manager or the process environment; never commit it.
POSTGRES_PASSWORD=change-me-before-use

API_HOST=0.0.0.0
API_PORT=8000
# Retained for local frontend tooling; Compose keeps Dashboard internal.
DASHBOARD_PORT=4173
AI_STUDIO_PORT=4174
TKAI_API_PORT=8000
TKAI_DASHBOARD_PORT=4173
TKAI_AI_STUDIO_PORT=4174
VITE_API_BASE_URL=/api
TKAI_BUSINESS_DATABASE=.local/data/business-platform-v2.db

# Required for local bootstrap. Supply both through the process environment and
# change the password immediately after first login. No default is provided.
TKAI_BOOTSTRAP_ADMIN_USERNAME=
TKAI_BOOTSTRAP_ADMIN_PASSWORD=

# Public Nginx gateway ports. The default Compose file uses HTTP_PORT.
# The production override also uses HTTPS_PORT and redirects HTTP to HTTPS.
HTTP_PORT=80
HTTPS_PORT=443

# Production TLS files are supplied by the operator and mounted read-only.
TLS_CERTIFICATE_PATH=./certs/tls.crt
TLS_PRIVATE_KEY_PATH=./certs/tls.key

POSTGRES_MIGRATE=true
POSTGRES_WAIT_ATTEMPTS=30
POSTGRES_WAIT_INTERVAL_SECONDS=1

# Optional observability override. Replace both Grafana credentials locally.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
PROMETHEUS_RETENTION=15d
LOKI_RETENTION=168h
