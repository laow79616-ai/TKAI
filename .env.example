POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tkai_marketplace
POSTGRES_USER=tkai
POSTGRES_PASSWORD=change-me-before-use

API_HOST=0.0.0.0
API_PORT=8000
# Retained for local frontend tooling; Compose keeps Dashboard internal.
DASHBOARD_PORT=4173
VITE_API_BASE_URL=/api

# Public Nginx gateway ports. Select exactly one Compose profile:
# development (HTTP) or production (HTTPS with HTTP redirect).
HTTP_PORT=80
HTTPS_PORT=443

# Production TLS files are supplied by the operator and mounted read-only.
TLS_CERTIFICATE_PATH=./certs/tls.crt
TLS_PRIVATE_KEY_PATH=./certs/tls.key

POSTGRES_MIGRATE=true
POSTGRES_WAIT_ATTEMPTS=30
POSTGRES_WAIT_INTERVAL_SECONDS=1
