logging {
  level  = "info"
  format = "logfmt"
}

discovery.docker "tkai" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "tkai" {
  targets = discovery.docker.tkai.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "(api|nginx|postgres|dashboard)"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service"
  }

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "tkai" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.tkai.output
  labels     = {stack = "tkai"}
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
